# MapArtisans — configuration Caddy de production.
#
# Caddy obtient et renouvelle seul les certificats Let's Encrypt. Aucune
# commande certbot, aucun cron de renouvellement.

{
	# Adresse de contact pour Let's Encrypt : c'est là qu'arrivent les alertes
	# d'expiration si un renouvellement échoue. Une adresse réellement relevée.
	email {$ADMIN_EMAIL}

	# --- TLS à la demande, pour les domaines d'agences en marque blanche.
	#
	# LA DIRECTIVE `ask` N'EST PAS FACULTATIVE. La documentation Caddy est
	# explicite : « On-demand TLS must be both enabled and restricted to
	# prevent abuse. » Sans elle, n'importe qui pointant n'importe quel domaine
	# vers cette IP déclenche une demande de certificat. Les quotas Let's
	# Encrypt étant globaux et non configurables par site, ils s'épuisent en
	# quelques heures — et PLUS AUCUN certificat n'est émis pendant une
	# semaine, y compris pour mapartisans.com lui-même.
	#
	# La route interrogée est app/api/tls/ask : elle répond 200 uniquement pour
	# un domaine enregistré en base, 404 sinon.
	on_demand_tls {
		ask http://app:3000/api/tls/ask
		# Plafond de sécurité supplémentaire : même si la route venait à
		# répondre 200 à tort, l'émission reste bornée.
		interval 2m
		burst 5
	}
}

# --- En-têtes de sécurité, appliqués à tous les sites via un extrait réutilisable.
(securite) {
	header {
		# Deux ans, sous-domaines inclus : le navigateur refusera toute
		# connexion HTTP à ce domaine, même si un lien en propose une.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# Caddy annonce sa version par défaut : inutile de renseigner un
		# éventuel attaquant sur la version exacte à cibler.
		-Server
	}
}

# --------------------------------------------------------------- domaine principal
mapartisans.com {
	import securite
	encode zstd gzip
	reverse_proxy app:3000 {
		health_uri /api/sante
		health_interval 15s
		# Sans cette ligne, l'application voit toutes les requêtes venir de
		# l'IP interne de Caddy : les journaux et toute limitation de débit par
		# adresse deviennent inexploitables.
		header_up X-Real-IP {remote_host}
	}
	log {
		output file /data/logs/mapartisans.log
		format json
	}
}

# --------------------------------------------------------------- domaines redirigés
# Les quatre domaines secondaires renvoient vers le .com en 301 (permanent),
# pour que les moteurs consolident toute l'autorité SEO sur une seule adresse.
# Une 302 laisserait Google indexer cinq sites au contenu identique — du
# contenu dupliqué qui dilue le classement au lieu de le renforcer.
#
# {uri} est conservé : mapartisans.ch/tarifs arrive sur mapartisans.com/tarifs,
# et non sur la page d'accueil. Un lien partagé continue de fonctionner.
# www.mapartisans.com est traité comme les autres : il redirige vers l'apex.
# Le servir à l'identique créerait deux adresses pour un même contenu — le
# défaut de duplication que ces redirections existent précisément pour éviter.
www.mapartisans.com,
mapartisans.ch, www.mapartisans.ch,
mapartisans.fr, www.mapartisans.fr,
mapartisans.online, www.mapartisans.online,
mapartisans.org, www.mapartisans.org {
	import securite
	redir https://mapartisans.com{uri} permanent
}

# --------------------------------------------------------------- marque blanche
# Cible des CNAME d'agences. Le bloc reste en place et inoffensif tant qu'aucune
# agence n'est enregistrée : /api/tls/ask répond 404 pour tout domaine inconnu,
# donc aucun certificat n'est jamais émis.
cname.mapartisans.com {
	import securite
	reverse_proxy app:3000
}

# Tout autre hôte arrivant sur ce serveur : accepté UNIQUEMENT si la route
# `ask` le reconnaît comme domaine d'agence enregistré.
:443 {
	tls {
		on_demand
	}
	import securite
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}
