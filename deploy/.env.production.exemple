# MapArtisans — variables de production.
#
# Copier en `.env.production` sur le serveur, remplir, puis :
#   chmod 600 .env.production
#
# CE FICHIER NE DOIT JAMAIS ÊTRE VERSIONNÉ. Les secrets vivent sur le serveur,
# jamais dans le dépôt ni dans une couche d'image Docker.

# --- Infrastructure
ADMIN_EMAIL=

# --- Base de données
POSTGRES_USER=mapartisans
POSTGRES_PASSWORD=
POSTGRES_DB=mapartisans

# --- Secrets applicatifs
# Générer chacun avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Services externes
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+41766014450

# --- Envoi d'e-mails
# Sans ces deux valeurs, aucun e-mail ne part et l'echec est journalise
# bruyamment. L'inscription continue de fonctionner : l'artisan est connecte
# immediatement, il n'a pas besoin du lien magique dans l'instant.
#
# EMAIL_FROM ne doit PAS etre une adresse en « no-reply » : nos messages
# invitent explicitement a repondre, et le code refuse ces adresses.
# Le domaine doit etre verifie chez le fournisseur (SPF + DKIM) avant que quoi
# que ce soit n'arrive ailleurs que dans les indesirables.
RESEND_API_KEY=
EMAIL_FROM=

# --- Facturation
FACTURATION_RAISON_SOCIALE=
FACTURATION_ADRESSE=
FACTURATION_EMAIL=
# LAISSER VIDE tant que le chiffre d'affaires annuel reste sous 100 000 CHF.
FACTURATION_IDE=
