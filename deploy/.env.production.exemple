# MapArtisans — variables de production.
#
# Copier en `.env.production` sur le serveur, remplir, puis :
#   chmod 600 .env.production
#
# CE FICHIER NE DOIT JAMAIS ÊTRE VERSIONNÉ. Les secrets vivent sur le serveur,
# jamais dans le dépôt ni dans une couche d'image Docker.

# --- Infrastructure
ADMIN_EMAIL=

# --- Base de données
POSTGRES_USER=mapartisans
POSTGRES_PASSWORD=
POSTGRES_DB=mapartisans

# --- Secrets applicatifs
# Générer chacun avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Services externes
OPENAI_API_KEY=
# --- OAuth Google Business Profile -------------------------------------
# Console Google Cloud > API et services > Identifiants > ID client OAuth.
# L'URI de redirection doit correspondre EXACTEMENT, y compris le schema.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mapartisans.com/api/auth/google/callback

TWILIO_ACCOUNT_SID=
# Deux authentifications possibles, l'une OU l'autre suffit.
# Preferer les cles API : revocables individuellement, sans couper le compte.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Repli. Le revoquer coupe tout l'acces Twilio, y compris les cles API.
TWILIO_AUTH_TOKEN=
# Expediteur affiche sur le telephone du destinataire. Deux formes possibles :
#   +41766014450  un numero E.164 — le destinataire peut repondre, mais le
#                 numero doit etre loue et son dossier reglementaire valide ;
#   MapArtisans   un expediteur alphanumerique, 11 caracteres au plus — aucun
#                 numero a louer, aucun dossier a valider, mais aucune reponse
#                 possible (le STOP doit alors passer par un autre canal).
TWILIO_FROM_NUMBER=MapArtisans

# --- Envoi d'e-mails
# Sans ces deux valeurs, aucun e-mail ne part et l'echec est journalise
# bruyamment. L'inscription continue de fonctionner : l'artisan est connecte
# immediatement, il n'a pas besoin du lien magique dans l'instant.
#
# EMAIL_FROM ne doit PAS etre une adresse en « no-reply » : nos messages
# invitent explicitement a repondre, et le code refuse ces adresses.
# Le domaine doit etre verifie chez le fournisseur (SPF + DKIM) avant que quoi
# que ce soit n'arrive ailleurs que dans les indesirables.
RESEND_API_KEY=
EMAIL_FROM=

# --- Paiement Stripe
# UTILISEZ D'ABORD DES CLES DE TEST (sk_test_ / pk_test_). Le code refuse tout
# autre prefixe : une cle publiable ou un identifiant d'un autre service
# echouerait sinon au premier appel, avec un message incomprehensible.
#
# STRIPE_WEBHOOK_SECRET vient du tableau de bord Stripe, section Webhooks.
# Sans elle, la route accepterait n'importe quel appel pretendant venir de
# Stripe — et n'importe qui s'activerait un abonnement gratuit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Facturation
FACTURATION_RAISON_SOCIALE=
FACTURATION_ADRESSE=
FACTURATION_EMAIL=
# LAISSER VIDE tant que le chiffre d'affaires annuel reste sous 100 000 CHF.
# IDE de l'entreprise (CHE-xxx.xxx.xxx), tel qu'il figure au registre du
# commerce. Toute entreprise inscrite en a un — cela ne dit RIEN de la TVA.
FACTURATION_IDE=
# Numero de TVA. A ne renseigner QU'APRES inscription au registre des
# assujettis : le renseigner fait apparaitre la TVA sur les factures, et en
# percevoir sans etre inscrit est une infraction.
FACTURATION_TVA=
